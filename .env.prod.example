# =============================================================
# iQuote — Production Environment Variables
# =============================================================
# Copy this file to .env.prod and fill in real values.
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
# NEVER commit .env.prod to git. It is in .gitignore.
# =============================================================

# ---- Database ----
POSTGRES_USER=iquote
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=iquote
# This must match the POSTGRES_* values above
DATABASE_URL=postgresql://iquote:replace-with-a-strong-random-password@db:5432/iquote?schema=public

# ---- Security ----
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of origins allowed to make credentialed requests.
# Include your main domain and any tenant subdomain patterns.
# Tenant subdomains matching https://*.TENANT_BASE_DOMAIN are auto-allowed.
TRUSTED_ORIGINS=https://iquote.trendscore.co.ke

# Used to encrypt tenant Resend API keys. Generate with:
#   openssl rand -base64 32
EMAIL_SETTINGS_ENCRYPTION_KEY=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Sender aliases used by TrendSCORE are also accepted if already configured:
# BILLING_FROM_EMAIL= or EMAIL_FROM=
RESEND_FROM_NAME=iQuote
# Optional display-name aliases: BILLING_FROM_NAME= or EMAIL_FROM_NAME=

# ---- Platform Branding ----
PLATFORM_NAME=iQuote
# The public URL of your deployed app (no trailing slash)
PLATFORM_URL=https://iquote.trendscore.co.ke
TENANT_BASE_DOMAIN=trendscore.co.ke
# Optional: URL to your logo (set after uploading via Settings)
PLATFORM_LOGO_URL=
# Optional: Custom header banner image (600px wide, ~180px tall)
PLATFORM_HEADER_IMAGE=
SUPPORT_EMAIL=hello@iquote.app

# ---- WhatsApp (future, not implemented) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
