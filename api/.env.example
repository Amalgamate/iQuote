PORT=4000
DATABASE_URL="postgresql://iquote:replace-with-local-password@localhost:5432/iquote?schema=public"
JWT_SECRET=replace-with-a-long-random-local-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Required only when tenants save their own Resend keys. Keep stable after tenant keys are stored.
EMAIL_SETTINGS_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64url-secret

# ---- Platform branding for email templates ----
# The name shown in email headers, footers, and subjects
PLATFORM_NAME=iQuote
# The public URL of your web app (used for CTA buttons and links)
PLATFORM_URL=http://localhost:5174
# Optional: URL to your platform logo image (PNG recommended, ~140px wide)
# If not set, the iQuote text wordmark is used instead
PLATFORM_LOGO_URL=
# Optional: URL to a custom header banner image (600px wide, ~180px tall)
# If not set, a built-in SVG banner with the iQuote brand is used
PLATFORM_HEADER_IMAGE=
# Reply-to email for customer support inquiries
SUPPORT_EMAIL=hello@iquote.app

# Future WhatsApp Business Cloud API platform sender configuration (not implemented yet).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
